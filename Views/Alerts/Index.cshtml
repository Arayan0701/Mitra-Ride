@model IEnumerable<MitraRide.Models.Alert>
@{Layout=null;var admin=Context.Session.GetString("Role")=="Admin";}<html><head><meta charset="utf-8"><title>Alerts</title><link rel="stylesheet" href="/css/site.css"></head><body><aside><div class="brand"><b>M</b><span>Mitra Ride<small>Emergency Support</small></span></div><nav><a href="/Dashboard">⌂ Dashboard</a><a href="/Vehicles">🚗 Vehicles</a><a href="/Documents">▣ Documents</a><a href="/Contacts">♧ Contacts</a><a class="active" href="/Alerts">⚠ Alerts</a>@if(admin){<a href="/Admin/Users">👥 Users</a>}</nav><a class="logout" href="/Account/Logout">↪ Logout</a></aside><main><header>Parking & Accident Alerts</header><section><div class="panel"><form method="post" action="/Alerts/Create" class="alert-form"><select name="Type"><option>Parking Assistance</option><option>Accident Emergency</option></select><input name="Vehicle" placeholder="Vehicle Number" required><textarea name="Message" placeholder="Describe the issue..." required></textarea><button>Create Alert</button></form><table><tr><th>Type</th><th>Vehicle</th><th>Message</th><th>Status</th><th>Time</th>@if(admin){<th>Action</th>}</tr>@foreach(var a in Model){<tr><td><b>@a.Type</b></td><td>@a.Vehicle</td><td>@a.Message</td><td>@a.Status</td><td>@a.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>@if(admin){<td><form method="post" action="/Alerts/Delete"><input type="hidden" name="id" value="@a.Id"><button class="danger">Delete</button></form></td>}</tr>}</table></div></section></main></body></html>
