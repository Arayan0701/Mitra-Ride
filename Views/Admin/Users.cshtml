@model IEnumerable<MitraRide.Models.AppUser>
@{Layout=null;}<html><head><meta charset="utf-8"><title>Admin Users</title><link rel="stylesheet" href="/css/site.css"></head><body><aside><div class="brand"><b>M</b><span>Mitra Ride<small>Administration</small></span></div><nav><a href="/Dashboard">⌂ Dashboard</a><a href="/Vehicles">🚗 Vehicles</a><a href="/Documents">▣ Documents</a><a href="/Contacts">♧ Contacts</a><a href="/Alerts">⚠ Alerts</a><a class="active" href="/Admin/Users">👥 Users</a></nav><a class="logout" href="/Account/Logout">↪ Logout</a></aside><main><header>User Management</header><section><div class="panel"><table><tr><th>Name</th><th>Username</th><th>Email</th><th>Role</th><th>Action</th></tr>@foreach(var u in Model){<tr><td>@u.Name</td><td>@u.Username</td><td>@u.Email</td><td>@u.Role</td><td>@if(u.Role!="Admin"){<form method="post" action="/Admin/DeleteUser"><input type="hidden" name="id" value="@u.Id"><button class="danger">Delete</button></form>}</td></tr>}</table></div></section></main></body></html>
