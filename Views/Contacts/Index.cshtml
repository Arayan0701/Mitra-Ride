@model IEnumerable<MitraRide.Models.EmergencyContact>
@{Layout=null;var admin=Context.Session.GetString("Role")=="Admin";}<html><head><meta charset="utf-8"><title>Contacts</title><link rel="stylesheet" href="/css/site.css"></head><body><aside><div class="brand"><b>M</b><span>Mitra Ride<small>Emergency Contacts</small></span></div><nav><a href="/Dashboard">⌂ Dashboard</a><a href="/Vehicles">🚗 Vehicles</a><a href="/Documents">▣ Documents</a><a class="active" href="/Contacts">♧ Contacts</a><a href="/Alerts">⚠ Alerts</a>@if(admin){<a href="/Admin/Users">👥 Users</a>}</nav><a class="logout" href="/Account/Logout">↪ Logout</a></aside><main><header>Emergency Contacts</header><section><div class="panel"><form method="post" action="/Contacts/Create" class="inline-form"><input name="Name" placeholder="Contact Name" required><input name="Relation" placeholder="Relation" required><input name="Phone" placeholder="+91..." required><button>Add Contact</button></form><table><tr><th>Name</th><th>Relation</th><th>Phone</th>@if(admin){<th>Action</th>}</tr>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Relation</td><td>@c.Phone</td>@if(admin){<td><form method="post" action="/Contacts/Delete"><input type="hidden" name="id" value="@c.Id"><button class="danger">Delete</button></form></td>}</tr>}</table></div></section></main></body></html>
