@{Layout=null;var admin=(string)ViewBag.Role=="Admin";}<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Mitra Ride Dashboard</title><link rel="stylesheet" href="/css/site.css"></head><body><aside><div class="brand"><b>M</b><span>Mitra Ride<small>@ViewBag.Role Portal</small></span></div><nav><a class="active" href="/Dashboard">⌂ Dashboard</a><a href="/Vehicles">🚗 Vehicles</a><a href="/Documents">▣ Documents</a><a href="/Contacts">♧ Emergency Contacts</a><a href="/Alerts">⚠ Alerts</a>@if(admin){<a href="/Admin/Users">👥 Users</a>}</nav><a class="logout" href="/Account/Logout">↪ Logout</a></aside><main><header><span>@(admin?"Administrator":"Arayan Savaliya")</span></header><section><div class="eyebrow">@(admin?"ADMINISTRATION":"USER PORTAL")</div><h1>@(admin?"System Overview":"Welcome back, Arayan 👋")</h1><p>Manage your Mitra Ride platform from one dashboard.</p><div class="stats"><div><small>VEHICLES</small><b>@ViewBag.Vehicles</b></div><div><small>DOCUMENTS</small><b>@ViewBag.Documents</b></div><div><small>CONTACTS</small><b>@ViewBag.Contacts</b></div><div><small>ALERTS</small><b>@ViewBag.Alerts</b></div></div><div class="cards"><a href="/Vehicles"><b>🚗 Vehicles</b><small>Manage registered vehicles</small></a><a href="/Documents"><b>▣ Documents</b><small>Track expiry and records</small></a><a href="/Contacts"><b>♧ Emergency Contacts</b><small>Manage emergency contacts</small></a><a href="/Alerts"><b>⚠ Emergency Alerts</b><small>Parking and accident support</small></a>@if(admin){<a href="/Admin/Users"><b>👥 User Management</b><small>Admin-only system control</small></a>}</div></section></main></body></html>
