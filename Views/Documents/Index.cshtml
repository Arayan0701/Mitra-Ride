@model IEnumerable<MitraRide.Models.VehicleDocument>
@{Layout=null;var admin=Context.Session.GetString("Role")=="Admin";}<html><head><meta charset="utf-8"><title>Documents</title><link rel="stylesheet" href="/css/site.css"></head><body><aside><div class="brand"><b>M</b><span>Mitra Ride<small>Document Management</small></span></div><nav><a href="/Dashboard">⌂ Dashboard</a><a href="/Vehicles">🚗 Vehicles</a><a class="active" href="/Documents">▣ Documents</a><a href="/Contacts">♧ Contacts</a><a href="/Alerts">⚠ Alerts</a>@if(admin){<a href="/Admin/Users">👥 Users</a>}</nav><a class="logout" href="/Account/Logout">↪ Logout</a></aside><main><header>Vehicle Documents</header><section><div class="panel"><form method="post" action="/Documents/Create" class="inline-form"><input name="VehiclePlate" placeholder="Vehicle Number" required><select name="Type"><option>Driving Licence</option><option>Registration Certificate</option><option>Insurance</option><option>Pollution Under Control</option></select><input name="Expiry" type="date" required><button>Add Document</button></form><table><tr><th>Document</th><th>Vehicle</th><th>Expiry</th><th>Status</th>@if(admin){<th>Action</th>}</tr>@foreach(var d in Model){<tr><td>@d.Type</td><td>@d.VehiclePlate</td><td>@d.Expiry.ToString("yyyy-MM-dd")</td><td><span class="ok">@d.Status</span></td>@if(admin){<td><form method="post" action="/Documents/Delete"><input type="hidden" name="id" value="@d.Id"><button class="danger">Delete</button></form></td>}</tr>}</table></div></section></main></body></html>
