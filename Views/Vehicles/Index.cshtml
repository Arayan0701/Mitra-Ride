@model IEnumerable<MitraRide.Models.Vehicle>
@{Layout=null;var admin=Context.Session.GetString("Role")=="Admin";}<html><head><meta charset="utf-8"><title>Vehicles</title><link rel="stylesheet" href="/css/site.css"></head><body><aside><div class="brand"><b>M</b><span>Mitra Ride<small>@(admin?"Admin":"User") Portal</small></span></div><nav><a href="/Dashboard">⌂ Dashboard</a><a class="active" href="/Vehicles">🚗 Vehicles</a><a href="/Documents">▣ Documents</a><a href="/Contacts">♧ Contacts</a><a href="/Alerts">⚠ Alerts</a>@if(admin){<a href="/Admin/Users">👥 Users</a>}</nav><a class="logout" href="/Account/Logout">↪ Logout</a></aside><main><header>Vehicle Management</header><section><div class="head"><div><div class="eyebrow">@(admin?"FULL ACCESS":"USER PORTAL")</div><h1>Vehicles</h1></div></div><div class="panel"><form method="post" action="/Vehicles/Create" class="inline-form"><input name="Name" placeholder="Vehicle Name" required><input name="Plate" placeholder="GJ 03 AB 1234" required><input name="Make" placeholder="Make" required><input name="Model" placeholder="Model" required><button>Add Vehicle</button></form><table><tr><th>Name</th><th>Number</th><th>Make / Model</th><th>Status</th>@if(admin){<th>Action</th>}</tr>@foreach(var v in Model){<tr><td>@v.Name</td><td><b>@v.Plate</b></td><td>@v.Make @v.Model</td><td><span class="ok">@v.Status</span></td>@if(admin){<td><form method="post" action="/Vehicles/Delete"><input type="hidden" name="id" value="@v.Id"><button class="danger">Delete</button></form></td>}</tr>}</table></div></section></main></body></html>
