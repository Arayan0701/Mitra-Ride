@{Layout=null;}<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>@ViewBag.Role Login</title><link rel="stylesheet" href="/css/site.css"></head><body class="login-page"><div class="login-box"><a class="back" href="/">← Back</a><span class="eyebrow">@ViewBag.Role ACCESS</span><h1>@ViewBag.Role Login</h1><p>Enter your separate @ViewBag.Role credentials.</p>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<form method="post"><input type="hidden" name="role" value="@ViewBag.Role"/><label>Username<input name="username" required value="@(ViewBag.Role=="Admin"?"admin":"user")"/></label><label>Password<input name="password" type="password" required value="@(ViewBag.Role=="Admin"?"admin123":"user123")"/></label><button>Login to @ViewBag.Role Dashboard</button></form><small class="hint">Demo: @(ViewBag.Role=="Admin"?"admin / admin123":"user / user123")</small></div></body></html>
